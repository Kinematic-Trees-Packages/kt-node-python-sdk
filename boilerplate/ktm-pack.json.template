{
  "schemaVersion": "ktm.pack.v2",
  "minimumKTMVersion": "1.2.20",
  "defaultMode": "compiled",
  "globalExclude": [
    "**/__pycache__/**",
    "**/*.py[cod]",
    "**/.pytest_cache/**",
    "**/.mypy_cache/**",
    "**/.ruff_cache/**",
    "**/.DS_Store"
  ],
  "lists": {
    "compiled": {
      "description": "Python source is the runtime artifact, so compiled mode includes the Python package tree.",
      "include": ["runtime"]
    },
    "source": {
      "description": "Python tests and examples used to develop and validate the runtime package.",
      "include": ["source"]
    }
  },
  "modes": {
    "compiled": {
      "description": "Publish only the compiled/runtime artifact list.",
      "lists": [
        "compiled"
      ]
    },
    "compiled-source": {
      "description": "Publish compiled/runtime artifacts plus the source list. Dependencies remain KTM-managed.",
      "lists": [
        "compiled",
        "source"
      ]
    }
  },
  "assertions": {
    "required": ["runtime/src"],
    "forbidden": ["**/__pycache__/**", "**/*.py[cod]", "**/.env", "**/*.pem"]
  },
  "limits": {"maximumFileBytes": 52428800, "maximumArchiveBytes": 209715200}
}
