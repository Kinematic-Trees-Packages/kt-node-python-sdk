{
  "schemaVersion": "ktm.pack.v2",
  "minimumKTMVersion": "1.2.20",
  "defaultMode": "compiled",
  "globalExclude": [
    "**/__pycache__/**",
    "**/*.py[cod]",
    "**/.pytest_cache/**",
    "**/.mypy_cache/**",
    "**/.ruff_cache/**",
    "**/.DS_Store"
  ],
  "lists": {
    "contracts": {
      "description": "The single package contract and optional sibling runtime configuration remain at archive root.",
      "include": ["package.ktm.json", "runtime.json"]
    },
    "compiled": {
      "description": "Python source is the runtime artifact; dependencies stay KTM-managed and are not vendored.",
      "include": ["pyproject.toml", "src"]
    },
    "source": {
      "description": "Optional development documentation and scripts for editable source packages.",
      "include": ["development"]
    }
  },
  "modes": {
    "compiled": {
      "description": "Publish only the compiled/runtime artifact list.",
      "lists": ["contracts", "compiled"]
    },
    "compiled-source": {
      "description": "Publish compiled/runtime artifacts plus the source list. Dependencies remain KTM-managed.",
      "lists": [
        "contracts",
        "compiled",
        "source"
      ]
    }
  },
  "assertions": {
    "required": [
      "package.ktm.json",
      "runtime.json",
      "src"
    ],
    "forbidden": ["**/__pycache__/**", "**/*.py[cod]", "**/.env", "**/*.pem"]
  },
  "limits": {"maximumFileBytes": 52428800, "maximumArchiveBytes": 209715200}
}
