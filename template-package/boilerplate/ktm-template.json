{
  "schemaVersion": "ktm.create-template.v1",
  "language": "python",
  "sdk": "python",
  "displayName": "Kinematic Trees Python process template",
  "templateRoot": "boilerplate",
  "generatedManifest": "package.ktm.json.template",
  "placeholders": [
    "PROJECT_NAME",
    "PACKAGE_NAME",
    "NAMESPACE",
    "DESCRIPTION_JSON_STRING",
    "AUTHOR_JSON_STRING",
    "DESCRIPTION_TOML_STRING",
    "AUTHOR_TOML_STRING",
    "LANGUAGE",
    "RUNTIME_SDK",
    "PRIMARY_PLATFORM",
    "PLATFORMS_JSON",
    "RUN_ENVIRONMENTS_JSON",
    "KT_NODE_VERSION",
    "MODULE_NAME"
  ],
  "literalContexts": {
    "package.ktm.json.template": "json",
    "pyproject.toml.template": "toml"
  },
  "copy": {
    "include": [
      "**/*"
    ],
    "exclude": [
      "ktm-template.json"
    ]
  },
  "finalize": {
    "templateSuffix": ".template",
    "deleteTemplateSuffix": true
  },
  "smoke": {
    "commands": [
      "scripts/test.sh"
    ],
    "timeoutSeconds": 600
  }
}
