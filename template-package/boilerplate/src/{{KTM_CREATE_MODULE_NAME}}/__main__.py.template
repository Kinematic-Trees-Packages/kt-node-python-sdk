from __future__ import annotations

import argparse

import ktnode as kt

from .process import Process


def main() -> None:
    parser = argparse.ArgumentParser(description="Run {{KTM_CREATE_PROJECT_NAME}}")
    parser.add_argument("--package", required=True, help="node package manifest")
    parser.add_argument("--runtime", required=True, help="runtime configuration")
    args = parser.parse_args()
    kt.run(args.package, args.runtime, Process())


if __name__ == "__main__":
    main()
