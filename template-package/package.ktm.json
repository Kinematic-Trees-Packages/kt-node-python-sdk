{
  "schemaVersion": "3",
  "metadata": {
    "namespace": "kinematic-trees",
    "name": "kt-python-template",
    "version": "0.1.0",
    "description": "KTM project template for Python processes using the KT Node Python SDK.",
    "author": "Kinematic Trees Package Team",
    "language": "python",
    "license": "MIT",
    "packageType": "local"
  },
  "files": ["boilerplate", "scripts/package.sh", "package.ktm.json"],
  "distribution": {"packages": [], "urlStrategy": "local-relative"},
  "runEnvironments": [
    {
