        "program": "python3",
        "args": ["-m", "minimum_contract", "--package", "runtime/node.package.json", "--runtime", "runtime/runtime.json"]
      },
      "timeoutSeconds": 600
    }]
  }],
  "runtime": {"sdk": "python"},
  "dependencies": {
    "system": [],
