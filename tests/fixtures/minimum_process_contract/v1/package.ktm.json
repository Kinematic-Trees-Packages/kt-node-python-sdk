{
  "schemaVersion": "3",
  "metadata": {
    "name": "python-minimum-contract",
    "namespace": "kinematic-trees",
    "version": "0.1.0",
    "description": "Versioned minimum typed Python process contract fixture.",
    "author": "Kinematic Trees",
    "language": "python",
    "license": "MIT",
    "packageType": "local"
  },
  "files": ["runtime.json", "src", "package.ktm.json"],
  "distribution": {"packages": []},
  "runEnvironments": [{
    "name": "linux_20",
    "type": "native",
    "os": "linux",
    "arch": "x64",
    "recipes": [{
      "action": "run",
      "command": {
        "program": "python3",
        "args": ["-m", "minimum_contract", "--package", "package.ktm.json", "--runtime", "runtime.json"]
      },
      "timeoutSeconds": 600
    }]
  }],
  "runtime": {"sdk": "python", "languageVersion": ">=3.9"},
  "dependencies": {
    "system": [],
    "packages": [
      {"owner": "kinematic-trees", "name": "kt-python-sdk", "version": "0.2.0", "classification": "library", "environments": {"linux_20": "linux_20"}},
      {"owner": "kinematic-trees", "name": "kt-messages", "version": "0.1.0", "classification": "data_types", "environments": {"linux_20": "portable"}}
    ],
    "optional": []
  },
  "resources": {"gpu": false, "ports": [], "x11": false},
  "dataflow": {
    "inputs": [{"name": "value", "datatype": "kt/common/int64_value", "description": "Required dimensionless signed 64-bit count", "required": true}],
    "outputs": [{"name": "incremented", "datatype": "kt/common/int64_value", "description": "Dimensionless signed 64-bit result"}]
  },
  "config": {
    "type": "object",
    "properties": {"increment": {"type": "integer", "default": 1, "description": "Dimensionless amount added to each input value"}},
    "required": ["increment"]
  }
}
